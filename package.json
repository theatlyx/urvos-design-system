{
  "name": "urvos-design-system",
  "version": "0.2.0",
  "private": true,
  "description": "Design tokens, component library, and Storybook catalog for Urvos Clinical OS. Drop /components, /lib, tokens.css, globals.css, and tailwind.config.ts into your Next.js 14 App Router project.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./tokens": {
      "types": "./tokens/index.ts",
      "import": "./tokens/index.ts",
      "require": "./tokens/index.ts"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.scss": "./tokens.scss",
    "./tokens.json": "./tokens.json",
    "./tokens-android.xml": "./tokens-android.xml",
    "./tokens-ios.json": "./tokens-ios.json"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.js",
    "build": "npm run build:tokens && tsup && tailwindcss -i ./globals.css -o ./dist/index.css --minify",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test-storybook": "test-storybook",
    "typecheck": "tsc --noEmit",
    "check:no-hardcoded-colors": "if grep -R -E \"#[0-9a-fA-F]{3,8}\" components/ || grep -R -E \"rgba?\\(\" components/ || grep -R -E \"(bg|text|border|fill|stroke)-(red|blue|green|yellow|purple|gray|indigo|pink|orange|teal)-[0-9]{2,3}\" components/; then echo 'Hardcoded colors detected'; exit 1; fi"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@medplum/fhirtypes": "^3.1.0",
    "@radix-ui/react-accordion": "^1.2.18",
    "@radix-ui/react-collapsible": "^1.1.18",
    "@radix-ui/react-context-menu": "^2.3.5",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-radio-group": "^1.4.5",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-slider": "^1.4.5",
    "@radix-ui/react-switch": "^1.3.5",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-toast": "^1.2.21",
    "@radix-ui/react-tooltip": "^1.2.14",
    "abs-svg-path": "^0.1.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.368.0",
    "parse-svg-path": "^0.2.0",
    "react-odontogram": "^0.5.6",
    "recharts": "^2.12.0",
    "@radix-ui/react-slot": "^1.0.2",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/nextjs": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test-runner": "^0.19.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "notes": {
    "why-cva-and-clsx": "Button.tsx is the reference implementation of the cva pattern. Badge/Form/Feedback still use manual string-concat className logic and should be migrated to match before this is considered consistent.",
    "why-not-tailwind-merge": "Not included by default \u2014 add `tailwind-merge` if you find className override conflicts (e.g. passing className=\"btn--sm\" to override a default size utility) once real Tailwind utility classes start getting passed alongside the design-system's own BEM-ish classes."
  }
}